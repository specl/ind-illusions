library(rstan)
# Assuming y, n, J, and delta are defined in your workspace
data_list = list(
y = y,
n = n,
J = J,
b = mean(delta),
nu = 4
)
# Stan model code as a string
stan_model_code = "
data {
int<lower=0> J;
int<lower=0> n;
matrix[n, J] y;
real<lower=0> b;
real<lower=0> nu;
}
parameters {
vector[J] mu;
vector<lower=0>[J] tau;
cov_matrix[J] Psi;
real<lower=0, upper=1> rho;
}
transformed parameters {
matrix[J, J] Sigma = (1 - rho) * diag_matrix(tau) + rho * Psi;
}
model {
mu ~ normal(100, 20);
tau ~ gamma((nu - J + 1) / 2, b^2 / 2);
Psi ~ wishart(nu, diag_matrix(rep_vector(b^2, J)));
rho ~ beta(1, 1);
for (i in 1:n) {
y[i] ~ multi_normal(mu, Sigma);
}
}
"
rstan_options(auto_write = TRUE)
options(mc.cores = 4)
stan_model = stan(
model_code = stan_model_code,
data = data_list,
chains = 4,
iter = 5000,
warmup = 1000,
control = list(max_treedepth = 15, adapt_delta = 0.95)
)
posterior_samples <- extract(stan_model)
rho_samples <- posterior_samples$rho
hist(rho_samples)
plot(1:length(rho_samples), rho_samples)
abline(h = mean(rho_samples), col = "red", lwd = 4)
mean(rho_samples)
cov(y)
Sig_samples = posterior_samples$Sigma
apply(Sig_samples, 2:3, mean)
