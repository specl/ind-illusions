mod.2 = "
model{
# Priors
for (j in 1:J){
mu[j] ~ dnorm(100, pow(20, -1))
for (k in 1:2){
lambda[j,k] ~ dnorm(0, pow(6, -2)) T(0,)
}
pSig2[j] ~ dgamma(.5,.5*tune^2)
Sig2[j] = 1/pSig2[j]
}
# Transform
for (jx in 1:J) {
for (jy in 1:J){
diag_Sig2[jx, jy] = (1 - step(abs(jx - jy) - 0.5))*Sig2[jx]
}
}
cross_product_lambda = lambda%*%t(lambda)
COV_SIG = cross_product_lambda + diag_Sig2
# Likelihood
for (i in 1:n){
y[i,1:J] ~ dmnorm.vcov(mu, COV_SIG)
}
}
"
set.seed(1234)
n = 100
J = 4
phi = cbind(rnorm(n, 0, 1), rnorm(n, 0, 1))
lambda = matrix(rep(c(15, 10, 5, 20), each = 2), nrow = J, ncol = 2)
mu = rnorm(4, 100, 20)
delta = matrix(rep(3), ncol = J)
y = matrix(NA, n, J)
for (i in 1:n){
for (j in 1:J){
y[i,j] = rnorm(1, mu[j] + sum(lambda[j,]*phi[i,]), delta[j]^2)
}
}
data_list = list(
"y" = y,
"n" = n,
"J" = J,
"tune" = mean(delta)
)
pars = c("COV_SIG", "lambda", "Sig2", "mu")
fit3 = runJags(mod.2, data_list, pars)
mu = as.array(fit3$BUGSoutput$sims.list$mu)
sig2 = as.array(fit3$BUGSoutput$sims.list$Sig2)
lambda = as.array(fit3$BUGSoutput$sims.list$lambda)
M = nrow(mu)
r.phi = array(NA, dim = c(M, n, 2))
for (m in 1:M){
temp_sig = solve(diag(4)*sig2[m,])
temp_lambda = lambda[m,,]
quad_form = t(temp_lambda)%*%temp_sig%*%temp_lambda
tau = solve((quad_form+diag(2)))
for (i in 1:n){
temp_c = t(temp_lambda)%*%temp_sig%*%matrix(y[i,]-mu[m,], nrow = 4)
mu_0 = tau%*%temp_c
r.phi[m,i,] = mvtnorm::rmvnorm(1, mu_0, tau)
}
}
r.phis = apply(r.phi, 2:3, mean)
apply(r.phis,2,var)
plot(phi[,1], r.phis[,2])
abline(0,1)
plot(phi[,2], r.phis[,1])
abline(0,1)
