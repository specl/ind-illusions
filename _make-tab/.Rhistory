source("../../mahbod/localize/_runs/latent/aux.R")
mod = "
model{
# Priors
for (j in 1:J){
mu[j] ~ dnorm(100, pow(20, -1))
lambda[j] ~ dnorm(0, pow(6, -2)) T(0,)
pSig2[j] ~ dgamma(.5,.5*tune^2)
Sig2[j] = 1/pSig2[j]
}
# Transform
for (jx in 1:J) {
for (jy in 1:J){
cross_product_lambda[jx, jy] = lambda[jx] * lambda[jy];
diag_Sig2[jx, jy] = (1 - step(abs(jx - jy) - 0.5))*Sig2[jx]
}
}
COV_SIG = cross_product_lambda + diag_Sig2
# Likelihood
for (i in 1:n){
y[i,1:J] ~ dmnorm.vcov(mu, COV_SIG)
}
}
"
set.seed(123)
n = 100
J = 4
phi = rnorm(n, 0, 1)
lambda = matrix(c(5, 10, 15, 20), nrow = J)
mu = rnorm(4, 100, 20)
delta = matrix(rep(3), ncol = J)
y = matrix(NA, n, J)
for (i in 1:n){
for (j in 1:J){
y[i,j] = rnorm(1, mu[j] + lambda[j]*phi[i], delta[j]^2)
}
}
data_list = list(
"y" = y,
"n" = n,
"J" = J,
"tune" = mean(delta)
)
pars = c("COV_SIG", "lambda", "Sig2", "mu")
fit = runJags(mod, data_list, pars)
mu = as.array(fit$BUGSoutput$sims.list$mu)
sig2 = as.array(fit$BUGSoutput$sims.list$Sig2)
lambda = as.array(fit$BUGSoutput$sims.list$lambda)
M = nrow(mu)
r.phi = matrix(NA, M, n)
for (m in 1:M){
tau = (sum(lambda[m,]^2/sig2[m,])+1)^(-1)
for (i in 1:n){
mu_0 = sum((y[i,]-mu[m,])*lambda[m,]/sig2[m,])*tau
r.phi[m,i] = rnorm(1, mu_0, tau)
}
}
r.phis = apply(r.phi, 2, mean)
var(r.phis)
plot(phi, r.phis)
abline(0,1)
