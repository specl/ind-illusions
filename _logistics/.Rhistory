library(grDevices)
colors = c("firebrick1", "gray95", "deepskyblue2")
palette_func = colorRampPalette(colors)
unique_colors = palette_func(200)
n.measures = ncol(cor_matrix)
col_cor_mat = matrix(unique_colors[cor_matrix*100+100], ncol = n.measures)
col_cor_mat = col_cor_mat[,n.measures:1]
temp_cor_matrix = cor_matrix[,n.measures:1]
plot(NA, NA,
xlim = c(-1,1),
ylim = c(-1,1),
axes = F,
asp = 1)
x = seq(-1, 1, length.out = n.measures+1)
length_rect = (x[2]-x[1])/2
x = x[1:n.measures]+length_rect
y = x
for (j in 1:n.measures){
j2 = n.measures-j+1
rect(x[j:n.measures]+length_rect,
y[j2] + length_rect,
x[j:n.measures]-length_rect,
y[j2] - length_rect,
col = col_cor_mat[j:n.measures, j2])
text(x = x[j:n.measures],
y = rep(y[j2], length(j:n.measures)),
labels = temp_cor_matrix[j:n.measures, j2],
cex = 1.2)
}
num_colors <- length(unique_colors)
legend_x_start <- max(par("usr")[1:2]) + 0.2  # Start a bit right from the plot
legend_y_start <- par("usr")[3]  # Bottom of the plot
legend_y_end <- par("usr")[4]   # Top of the plot
legend_width <- 0.1  # Width of each color strip in the legend
# Draw the rectangles for the legend
for (i in 1:num_colors) {
rect(legend_x_start,
legend_y_start + (i-1)/num_colors * (legend_y_end - legend_y_start),
legend_x_start + legend_width,
legend_y_start + i/num_colors * (legend_y_end - legend_y_start),
col = unique_colors[i], border = NA)
}
# Adding labels for the legend (optional)
axis(4, at = c(legend_y_start, mean(c(legend_y_start, legend_y_end)), legend_y_end),
labels = c("Min", "Mid", "Max"), las = 2)
