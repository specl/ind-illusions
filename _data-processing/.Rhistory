makePlot = function(i, v=2){
ind = which(dat$J == i & dat$block == v)
tdat = dat[ind,]
tdat$scaled_y = scale(tdat$y)
scores = tapply(tdat$scaled_y, list(tdat$trial, tdat$sub), mean)
tscores = scores
tscores = scores[2:15,] - scores[1:14,]
tscores[1,] = 0
matplot(scores, type = "l",
lty = 1,
lwd = 1,
xlab = "Trials",
ylab = "Scores",
main = task_names[i],
col = "#155238",
axes = F,
ylim = c(-7,7),
xlim = c(1,15))
axis(2, at = -6:6, labels = -6:6)
axis(1, at = 1:15, labels = 1:15)
mean_diag = apply(scores,1,function(x) mean(x, na.rm = T))
lines(mean_diag, col = "#94C288", lwd = 3)
}
par(mfrow=c(3,2))
plot_list = list(1,2,3,4,5)
mapply(makePlot, plot_list)
makePlot = function(i, v=2){
ind = which(dat$J == i & dat$block == v)
tdat = dat[ind,]
tdat$scaled_y = scale(tdat$y)
scores = tapply(tdat$scaled_y, list(tdat$trial, tdat$sub), mean)
tscores = scores
tscores = scores[2:15,] - scores[1:14,]
tscores[1,] = 0
matplot(tscores, type = "l",
lty = 1,
lwd = 1,
xlab = "Trials",
ylab = "Scores",
main = task_names[i],
col = "#155238",
axes = F,
ylim = c(-7,7),
xlim = c(1,15))
axis(2, at = -6:6, labels = -6:6)
axis(1, at = 1:15, labels = 1:15)
mean_diag = apply(tscores,1,function(x) mean(x, na.rm = T))
lines(mean_diag, col = "#94C288", lwd = 3)
}
