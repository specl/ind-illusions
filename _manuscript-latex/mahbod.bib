@article{Chavant.Kapoula.2022,
  title = {Loss of Audiovisual Facilitation with Age Occurs for Vergence Eye Movements but Not for Saccades},
  author = {Chavant, Martin and Kapoula, Zoï},
  date = {2022-03-15},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci Rep},
  volume = {12},
