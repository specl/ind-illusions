  file = {/Users/mahbod/Zotero/storage/XDK39G5S/2013-29647-001.html}
}

@article{Stankov.etal.2001,
  title = {Tactile and Kinesthetic Perceptual Processes within the Taxonomy of Human Cognitive Abilities},
