  author = {Mihalik, Agoston and Ferreira, Fabio S. and Moutoussis, Michael and Ziegler, Gabriel and Adams, Rick A. and Rosa, Maria J. and Prabhu, Gita and family=Oliveira, given=Leticia, prefix=de, useprefix=true and Pereira, Mirtes and Bullmore, Edward T. and Fonagy, Peter and Goodyer, Ian M. and Jones, Peter B. and Hauser, Tobias and Neufeld, Sharon and Romero-Garcia, Rafael and St Clair, Michelle and Vértes, Petra E. and Whitaker, Kirstie and Inkster, Becky and Ooi, Cinly and Toseeb, Umar and Widmer, Barry and Bhatti, Junaid and Villis, Laura and Alrumaithi, Ayesha and Birt, Sarah and Bowler, Aislinn and Cleridou, Kalia and Dadabhoy, Hina and Davies, Emma and Firkins, Ashlyn and Granville, Sian and Harding, Elizabeth and Hopkins, Alexandra and Isaacs, Daniel and King, Janchai and Kokorikou, Danae and Maurice, Christina and McIntosh, Cleo and Memarzia, Jessica and Mills, Harriet and O’Donnell, Ciara and Pantaleone, Sara and Scott, Jenny and Fearon, Pasco and Suckling, John and family=Harmelen, given=Anne-Laura, prefix=van, useprefix=true and Kievit, Rogier and Shawe-Taylor, John and Dolan, Raymond and Mourão-Miranda, Janaina},
  date = {2020-02-15},
  journaltitle = {Biological Psychiatry},
  shortjournal = {Biological Psychiatry},
  series = {Innovations in {{Clinical Neuroscience}}: {{Tools}}, {{Techniques}}, and {{Transformative Frameworks}}},
  volume = {87},
