  author = {Draheim, Christopher and Mashburn, Cody A. and Martin, Jessie D. and Engle, Randall W.},
  date = {2019-05},
  journaltitle = {Psychological Bulletin},
  shortjournal = {Psychological Bulletin},
  volume = {145},
