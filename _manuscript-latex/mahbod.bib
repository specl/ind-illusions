@article{Cottier.etal.2023,
  title = {Exploring the Extent to Which Shared Mechanisms Contribute to Motion-Position Illusions},
  author = {Cottier, Timothy V. and Turner, William and Holcombe, Alex O. and Hogendoorn, Hinze},
  date = {2023-09-13},
  journaltitle = {Journal of Vision},
