@article{Stevenson.etal.2024,
  title = {Joint {{Modelling}} of {{Latent Cognitive Mechanisms Shared Across Decision-Making Domains}}},
  author = {Stevenson, Niek and Innes, Reilly J. and Boag, Russell J. and Miletić, Steven and Isherwood, Scott J. S. and Trutti, Anne C. and Heathcote, Andrew and Forstmann, Birte U.},
  date = {2024-03-01},
