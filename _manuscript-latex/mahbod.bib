@article{Jastrzebski.etal.2021,
  title = {Galton and {{Spearman}} Revisited: {{Can}} Single General Discrimination Ability Drive Performance on Diverse Sensorimotor Tasks and Explain Intelligence?},
  shorttitle = {Galton and {{Spearman}} Revisited},
  author = {Jastrzębski, Jan and Kroczek, Bartłomiej and Chuderski, Adam},
