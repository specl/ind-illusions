@article{Haaf.Rouder.2017,
  title = {Developing Constraint in Bayesian Mixed Models},
  author = {Haaf, Julia M. and Rouder, Jeffrey N.},
  date = {2017},
  journaltitle = {Psychological Methods},
  volume = {22},
  number = {4},
  pages = {779--798},
